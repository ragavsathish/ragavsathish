role:MeginSeniorSoftwareDeveloperArchitect
    a :CareerRole ;
    schema:roleName "Senior Software Developer / Architect" ;
    schema:startDate "2021-09" ;
    schema:endDate "2025-10" ;
    :atOrganization org:MEGIN ;
    :inDomain domain:MedicalDeviceSoftware, domain:RegulatedHealthcare ;
    :translates domain:ClinicalValidation, domain:MedicalDeviceSoftware ;
    :accelerates domain:BureaucraticReleaseCycles ;
    :builtWith
        skill:TypeScript,
        skill:PostgreSQL,
        skill:AWS,
        skill:Terraform,
        skill:Docker,
        skill:Kubernetes,
        skill:GitLab,
        skill:Kairos,
        skill:LDAP,
        skill:ADFS,
        skill:EntraID,
        skill:PACS ;
    rdfs:comment "Architected secure hybrid cloud/on-prem software for medical device systems, FDA-compliant workflows, hospital integrations, design transfer, CI/CD, cybersecurity, and AI-assisted engineering adoption." .

