#################################################################
# Medtech problem model from the conversation
#################################################################

:ResearchToProductTranslation
    a skos:Concept ;
    skos:prefLabel "Research to Product Translation" ;
    :requires
        domain:ClinicalValidation,
        domain:MedicalDeviceSoftware,
        domain:RegulatedHealthcare,
        domain:PostMarketSurveillance ;
    rdfs:comment "The path from promising research software and clinical insight to compliant, traceable, usable healthcare products." .

:HumanInTheLoopValidation
    a skos:Concept ;
    skos:prefLabel "Human-in-the-loop Validation" ;
    :contributesTo domain:ClinicalValidation ;
    rdfs:comment "Keeping expert users, clinicians, operators, and affected people involved throughout discovery, design, validation, and surveillance." .

:ContentProduction
    a skos:Concept ;
    skos:prefLabel "Content Production" ;
    :contributesTo domain:DigitalHealth ;
    rdfs:comment "Producing and maintaining trustworthy product, care, or education content with tooling support and explicit review loops." .

:LifeSavingHealthcareAccess
    a skos:Concept ;
    skos:prefLabel "Life-saving Healthcare Access" ;
    :contributesTo domain:AccessibleHealthcare, value:ImproveHumanWellBeing ;
    rdfs:comment "Helping communities access critical health information, self-care support, and healthcare pathways that can protect life and well-being." .

:CommunitySelfCare
    a skos:Concept ;
    skos:prefLabel "Community Self-care" ;
    :contributesTo domain:AccessibleHealthcare, domain:DigitalHealth ;
    rdfs:comment "Supporting communities with personalised and location-specific health information so people can carry out recommended self-care tasks." .

:HomeBasedCareTasks
    a skos:Concept ;
    skos:prefLabel "WHO-recommended Home-based Care Tasks" ;
    :contributesTo :CommunitySelfCare ;
    rdfs:comment "Care tasks recommended for home execution, including maternal, newborn, reproductive, nutrition, mental health, and climate-triggered health contexts." .

:SecureHealthWallet
    a skos:Concept ;
    skos:prefLabel "Secure Health Wallet" ;
    :contributesTo domain:DigitalHealth, value:Accountability ;
    rdfs:comment "A secure place for people to store health data and records as part of a digital self-care service." .

:HealthDataDiversity
    a skos:Concept ;
    skos:prefLabel "Health Data Diversity" ;
    :contributesTo domain:AIEnabledHealthcare, value:Evidence ;
    rdfs:comment "Bridging the data diversity gap across the health research and development continuum." .

:ClimateHealthRiskManagement
    a skos:Concept ;
    skos:prefLabel "Climate Health Risk Management" ;
    :contributesTo domain:ClimateHealth, domain:AccessibleHealthcare ;
    rdfs:comment "Helping people understand and manage health risks triggered or intensified by climate change." .

:PublicHealthSystemEfficiency
    a skos:Concept ;
    skos:prefLabel "Public Health System Efficiency" ;
    :contributesTo domain:AccessibleHealthcare ;
    rdfs:comment "Saving government and public health system resources by helping communities access information and perform appropriate home-based care tasks." .

:OfflineFirstCareAccess
    a skos:Concept ;
    skos:prefLabel "Offline-first Care Access" ;
    :contributesTo domain:AccessibleHealthcare ;
    rdfs:comment "Designing mobile health workflows to remain useful with intermittent connectivity, including over-the-air updates when connectivity is available." .

:HealthChatbotGuardrails
    a skos:Concept ;
    skos:prefLabel "Health Chatbot Guardrails" ;
    :contributesTo domain:AIEnabledHealthcare, value:Evidence, value:Accountability ;
    rdfs:comment "Evaluation and control patterns for keeping health chatbot responses grounded, reviewed, and within intended safety boundaries." .

:LocalLLMJudgeEvaluation
    a skos:Concept ;
    skos:prefLabel "Local LLM Judge Evaluation" ;
    :contributesTo domain:LLMEvaluation, value:Evidence, value:Accountability ;
    rdfs:comment "Using a locally served LLM as an evaluation judge for prompt quality, grounding, hallucination rejection, and answer usefulness." .

:PromptFeedbackLoop
    a skos:Concept ;
    skos:prefLabel "Prompt Feedback Loop" ;
    :contributesTo domain:LLMEvaluation, value:Evidence ;
    rdfs:comment "Iterating prompts through automated scenarios, scoring, and failure analysis until grounded behavior improves." .

:ModelSelectionForLocalHardware
    a skos:Concept ;
    skos:prefLabel "Model Selection for Local Hardware" ;
    :contributesTo domain:LocalLLMEngineering ;
    rdfs:comment "Choosing local models based on the current machine's CPU, memory, GPU availability, and practical eval latency." .

:BrowserWebGPUModelExecution
    a skos:Concept ;
    skos:prefLabel "Browser WebGPU Model Execution" ;
    :contributesTo domain:LocalLLMEngineering, domain:LocalFirstAI ;
    rdfs:comment "Running small language models directly in the browser with WebGPU acceleration so local or client-side interaction can avoid a server round trip." .

:ClientSideModelLoading
    a skos:Concept ;
    skos:prefLabel "Client-side Model Loading" ;
    :contributesTo domain:LocalFirstAI ;
    rdfs:comment "Loading a browser-compatible model from the internet and relying on browser caching for repeated local use." .

:ClientSideWasmLLMApps
    a skos:Concept ;
    skos:prefLabel "Client-side WASM LLM Apps" ;
    :contributesTo domain:LocalFirstAI, domain:LocalLLMEngineering ;
    rdfs:comment "Building privacy-first LLM-powered web applications where model execution or runtime support happens in the browser through client-side WebAssembly-style deployment." .

:OnDeviceRetrieval
    a skos:Concept ;
    skos:prefLabel "On-device Retrieval" ;
    :contributesTo :OfflineFirstCareAccess, domain:AccessibleHealthcare ;
    rdfs:comment "Retrieving locally stored content through tool calls to an on-device SQLite database, forming the local RAG path for assistant responses." .

:WorkflowVisualization
    a skos:Concept ;
    skos:prefLabel "Workflow Visualization" ;
    :accelerates :ResearchToProductTranslation ;
    rdfs:comment "Making clinical and operational workflows visible so research-grade ideas can become traceable products without losing empathy." .

:CompliantProductPipeline
    a skos:Concept ;
    skos:prefLabel "Compliant Product Pipeline" ;
    :accelerates :ResearchToProductTranslation ;
    :requires value:Accountability, value:Evidence ;
    rdfs:comment "A disciplined path for requirements, testing, traceability, release, validation, and post-market learning." .

:UserLayerModel
    a skos:Concept ;
    skos:prefLabel "Layered User Model for Medtech" ;
    skos:narrower
        :Patient,
        :Clinician,
        :ExpertUser,
        :HospitalIT,
        :RegulatoryStakeholder,
        :Manufacturer,
        :SupportEngineer,
        :Caregiver,
        :PayerOrPolicyActor ;
    rdfs:comment "A model recognizing that medtech products have many users and beneficiaries, each with different needs and constraints." .

:Patient a skos:Concept ; skos:prefLabel "Patient" .
:Clinician a skos:Concept ; skos:prefLabel "Clinician" .
:ExpertUser a skos:Concept ; skos:prefLabel "Expert User" .
:HospitalIT a skos:Concept ; skos:prefLabel "Hospital IT" .
:RegulatoryStakeholder a skos:Concept ; skos:prefLabel "Regulatory Stakeholder" .
:Manufacturer a skos:Concept ; skos:prefLabel "Manufacturer" .
:SupportEngineer a skos:Concept ; skos:prefLabel "Support Engineer" .
:Caregiver a skos:Concept ; skos:prefLabel "Caregiver" .
:PayerOrPolicyActor a skos:Concept ; skos:prefLabel "Payer or Policy Actor" .

me:me
    :guidedBy :HumanInTheLoopValidation, :WorkflowVisualization, :CompliantProductPipeline, :UserLayerModel ;
    :translates :ResearchToProductTranslation .

