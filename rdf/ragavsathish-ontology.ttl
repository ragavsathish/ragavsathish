domain:DisconnectedHealthcareIT
    a :Domain ;
    skos:prefLabel "Disconnected Healthcare IT" ;
    rdfs:comment "Fragmented systems that make it difficult for healthcare tools, data, workflows, and people to communicate." .

domain:DelayedClinicalFeedback
    a :Domain ;
    skos:prefLabel "Delayed Clinical Feedback" ;
    rdfs:comment "A medtech pattern where products are built compliance-first and user feedback arrives too late." .

domain:BureaucraticReleaseCycles
    a :Domain ;
    skos:prefLabel "Bureaucratic Release Cycles" ;
    rdfs:comment "Slow bug fixes and releases that frustrate users and block workflow continuity." .

domain:LostEmpathyInTranslation
    a :Domain ;
    skos:prefLabel "Lost Empathy in Translation" ;
    rdfs:comment "The loss that happens when business, compliance, and engineering translate user needs without staying close to people." .

