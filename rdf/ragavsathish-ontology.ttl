#################################################################
# Ontology metadata
#################################################################

:RagavSathishOntology
    a owl:Ontology ;
    dcterms:title "Sathish Kumar Narayanan Personal Ontology" ;
    dcterms:description "An RDFS/Turtle ontology and knowledge graph describing Sathish Kumar Narayanan's career, philosophy, medtech work, research background, and practices for human well-being." ;
    dcterms:creator me:me ;
    dcterms:created "2026-07-26"^^xsd:date ;
    dcterms:format "text/turtle" ;
    rdfs:seeAlso <https://ragavsathish.github.io/> .

#################################################################
# RDFS vocabulary
#################################################################

:Purpose
    a rdfs:Class ;
    rdfs:label "Purpose" ;
    rdfs:comment "A long-lived motivating direction that gives meaning to work and practice." .

:Value
    a rdfs:Class ;
    rdfs:label "Value" ;
    rdfs:comment "An ethical or personal principle that guides decisions." .

:Practice
    a rdfs:Class ;
    rdfs:label "Practice" ;
    rdfs:comment "A repeated embodied, reflective, technical, or relational activity." .

:CareerRole
    a rdfs:Class ;
    rdfs:label "Career role" ;
    rdfs:subClassOf schema:Role ;
    rdfs:comment "A professional role held by a person in an organization." .

:Project
    a rdfs:Class ;
    rdfs:label "Project" ;
    rdfs:subClassOf schema:CreativeWork ;
    rdfs:comment "A product, platform, research system, or technical initiative." .

:Technology
    a rdfs:Class ;
    rdfs:label "Technology" ;
    rdfs:subClassOf skos:Concept ;
    rdfs:comment "A technical method, platform, language, or tool." .

:Domain
    a rdfs:Class ;
    rdfs:label "Domain" ;
    rdfs:subClassOf skos:Concept ;
    rdfs:comment "A field of practice or knowledge." .

:Product
    a rdfs:Class ;
    rdfs:label "Product" ;
    rdfs:subClassOf schema:Product ;
    rdfs:comment "A product or product family connected to Sathish's work." .

:hasPurpose
    a rdf:Property ;
    rdfs:label "has purpose" ;
    rdfs:domain schema:Person ;
    rdfs:range :Purpose .

:guidedBy
    a rdf:Property ;
    rdfs:label "guided by" ;
    rdfs:domain schema:Person ;
    rdfs:range :Value .

:practices
    a rdf:Property ;
    rdfs:label "practices" ;
    rdfs:domain schema:Person ;
    rdfs:range :Practice .

:developsThrough
    a rdf:Property ;
    rdfs:label "develops through" ;
    rdfs:domain schema:Person ;
    rdfs:range :Practice .

:contributesTo
    a rdf:Property ;
    rdfs:label "contributes to" ;
    rdfs:range skos:Concept .

:seeksToReduce
    a rdf:Property ;
    rdfs:label "seeks to reduce" ;
    rdfs:range skos:Concept .

:hasCareerRole
    a rdf:Property ;
    rdfs:label "has career role" ;
    rdfs:domain schema:Person ;
    rdfs:range :CareerRole .

:atOrganization
    a rdf:Property ;
    rdfs:label "at organization" ;
    rdfs:domain :CareerRole ;
    rdfs:range schema:Organization .

:workedOn
    a rdf:Property ;
    rdfs:label "worked on" ;
    rdfs:domain schema:Person ;
    rdfs:range :Project .

:exploresAsHobby
    a rdf:Property ;
    rdfs:label "explores as hobby" ;
    rdfs:domain schema:Person ;
    rdfs:range :Project .

:builtWith
    a rdf:Property ;
    rdfs:label "built with" ;
    rdfs:range :Technology .

:inDomain
    a rdf:Property ;
    rdfs:label "in domain" ;
    rdfs:range :Domain .

:translates
    a rdf:Property ;
    rdfs:label "translates" ;
    rdfs:comment "Connects research, user needs, regulatory constraints, and product systems." .

:accelerates
    a rdf:Property ;
    rdfs:label "accelerates" ;
    rdfs:comment "Describes a role or project that helps move learning, validation, or delivery faster." .

:requires
    a rdf:Property ;
    rdfs:label "requires" .

:learnedFrom
    a rdf:Property ;
    rdfs:label "learned from" .

:usesLearningResource
    a rdf:Property ;
    rdfs:label "uses learning resource" ;
    rdfs:range schema:CreativeWork .

:expresses
    a rdf:Property ;
    rdfs:label "expresses" .

#################################################################
# Person
#################################################################

me:me
    a schema:Person, foaf:Person ;
    schema:name "Sathish Kumar Narayanan" ;
    foaf:name "Sathish Kumar Narayanan" ;
    schema:url <https://ragavsathish.github.io/> ;
    schema:sameAs <https://github.com/ragavsathish> ;
    schema:homeLocation [
        a schema:Place ;
        schema:name "Espoo, Finland"
    ] ;
    schema:jobTitle "Healthcare Technology Engineer and Technology Lead" ;
    :hasPurpose value:ImproveHumanWellBeing ;
    :guidedBy
        value:HumanWellBeing,
        value:HumanDignity,
        value:Craftsmanship,
        value:Humility,
        value:ContinuousLearning,
        value:SystemsEmpathy,
        value:Evidence,
        value:Accountability ;
    :practices
        practice:Engineering,
        practice:ScientificResearch,
        practice:ProductDiscovery,
        practice:CustomerCloseness,
        practice:Meditation,
        practice:SwingDance,
        practice:Retrospection,
        practice:TeachingAndMentoring ;
    :developsThrough
        practice:TransferLearning,
        practice:HandsOnBuilding,
        practice:ClinicalObservation,
        practice:ConflictToHarmony ;
    :seeksToReduce
        domain:DisconnectedHealthcareIT,
        domain:DelayedClinicalFeedback,
        domain:BureaucraticReleaseCycles,
        domain:LostEmpathyInTranslation ;
    :exploresAsHobby
        project:PersonalSemanticWebProfile,
        project:RdfFitAssistant,
        project:PromptfooRdfEvalHarness,
        project:BrowserWebGPULLMEngineering,
        project:LocalLLMEngineering,
        project:DomainDrivenArchitectureLearning ;
    :workedOn
        project:MEGMapsPlatform,
        project:HallaHealth,
        project:AlaLaurilaDataAcquisition,
        project:RetinalCircuitAnalysis,
        project:SignantCloudMigration,
        project:SeppoSinglePageApplication,
        project:InfosysAutomatedGrading ;
    :hasCareerRole
        role:MeginSeniorSoftwareDeveloperArchitect,
        role:ScopeImpactTechnologyLead,
        role:SignantSeniorSoftwareDesigner,
        role:SignantSoftwareDesigner,
        role:SeppoSoftwareDeveloper,
        role:AaltoGraduateResearcher,
        role:InfosysEducationResearch,
        role:InfosysSeniorSystemsEngineer,
        role:InfosysSystemsEngineer .

#################################################################
# Purpose and values
#################################################################

value:ImproveHumanWellBeing
    a :Purpose, skos:Concept ;
    skos:prefLabel "Improve Human Well-being" ;
    rdfs:comment "The north-star purpose: use technology, science, leadership, and embodied practices to improve access, quality of life, and meaningful human capability." ;
    :contributesTo
        value:HumanWellBeing,
        value:HumanDignity,
        domain:AccessibleHealthcare,
        domain:QualityOfLife .

value:HumanWellBeing
    a :Value, skos:Concept ;
    skos:prefLabel "Human Well-being" ;
    skos:altLabel "Human flourishing", "Quality of life" ;
    rdfs:comment "A practical and ethical framing that includes physical, mental, emotional, social, and economic dimensions of living well." .

value:HumanDignity
    a :Value, skos:Concept ;
    skos:prefLabel "Human Dignity" ;
    rdfs:comment "The belief that people deserve access to education, healthcare, appreciation, and tools that let them live with self-respect." .

value:Craftsmanship
    a :Value, skos:Concept ;
    skos:prefLabel "Craftsmanship" ;
    rdfs:comment "The selfishness-with-gratitude idea: take joy in mastery while using that mastery in service of others." .

value:Humility
    a :Value, skos:Concept ;
    skos:prefLabel "Humility" ;
    rdfs:comment "A readiness to contribute, learn, be vulnerable, and grow into ownership through experience and feedback from others." .

value:ContinuousLearning
    a :Value, skos:Concept ;
    skos:prefLabel "Continuous Learning" ;
    rdfs:comment "Learn quickly from mistakes, transfer learning across domains, and keep improving through reflection." .

value:SystemsEmpathy
    a :Value, skos:Concept ;
    skos:prefLabel "Systems Empathy" ;
    rdfs:comment "The discipline of keeping real users, clinicians, operators, and patients visible inside complex technical and regulatory systems." .

value:Evidence
    a :Value, skos:Concept ;
    skos:prefLabel "Evidence" ;
    rdfs:comment "Respect for scientific, clinical, operational, and post-market evidence when turning research into products." .

value:Accountability
    a :Value, skos:Concept ;
    skos:prefLabel "Accountability" ;
    rdfs:comment "A response to non-accountability: make ownership, traceability, and follow-through visible." .

#################################################################
# Practices
#################################################################

practice:Engineering
    a :Practice, skos:Concept ;
    skos:prefLabel "Engineering" ;
    :contributesTo value:ImproveHumanWellBeing ;
    rdfs:comment "Building reliable software, platforms, infrastructure, and workflows that can survive real-world constraints." .

practice:ScientificResearch
    a :Practice, skos:Concept ;
    skos:prefLabel "Scientific Research" ;
    :contributesTo value:Evidence ;
    rdfs:comment "Using experimental and analytical methods to understand biological and clinical systems." .

practice:ProductDiscovery
    a :Practice, skos:Concept ;
    skos:prefLabel "Product Discovery" ;
    rdfs:comment "Visualizing workflows, testing assumptions, and learning from actual users before the system hardens." .

practice:CustomerCloseness
    a :Practice, skos:Concept ;
    skos:prefLabel "Customer Closeness" ;
    rdfs:comment "Installing, observing, listening, and using first-hand feedback to keep product development connected to practice." .

practice:Meditation
    a :Practice, skos:Concept ;
    skos:prefLabel "Meditation" ;
    :contributesTo value:HumanWellBeing ;
    rdfs:comment "A reflective practice of returning attention, cultivating contentment, and sharing value." .

practice:SwingDance
    a :Practice, skos:Concept ;
    skos:prefLabel "Swing Dance" ;
    :contributesTo value:HumanWellBeing ;
    :expresses value:Craftsmanship, value:HumanDignity ;
    rdfs:comment "An embodied practice where individuality, communication, rhythm, joy, and coexistence become visible." .

practice:Retrospection
    a :Practice, skos:Concept ;
    skos:prefLabel "Retrospection" ;
    rdfs:comment "Looking back honestly, learning from mistakes, and trying again." .

practice:TeachingAndMentoring
    a :Practice, skos:Concept ;
    skos:prefLabel "Teaching and Mentoring" ;
    rdfs:comment "Sharing knowledge through seminars, internships, and collaborative technical growth." .

practice:TransferLearning
    a :Practice, skos:Concept ;
    skos:prefLabel "Transfer Learning" ;
    rdfs:comment "Moving insight across bioinformatics, neuroscience, healthcare software, cloud systems, AI, and product work." .

practice:HandsOnBuilding
    a :Practice, skos:Concept ;
    skos:prefLabel "Hands-on Building" ;
    rdfs:comment "Learning by making, shipping, breaking assumptions, and improving the system." .

practice:ClinicalObservation
    a :Practice, skos:Concept ;
    skos:prefLabel "Clinical Observation" ;
    rdfs:comment "Learning from hospitals, expert users, deployments, and operational constraints." .

practice:ConflictToHarmony
    a :Practice, skos:Concept ;
    skos:prefLabel "Conflict to Harmony" ;
    rdfs:comment "Planting seeds, surfacing conflict, and working toward better rhythm and alignment." .

