{
  "type": "module",
  "scripts": {
    "generate:rdf-graph": "node scripts/generate-rdf-graph.mjs",
    "check:app": "node --check semantic-web/app.js && test -f semantic-web/index.html && test -f semantic-web/styles.css",
    "eval": "promptfoo eval --no-cache",
    "eval:prompt": "promptfoo eval -c promptfoo-llm-prompt.config.yaml --no-cache",
    "eval:judge": "promptfoo eval -c promptfoo-llm-judge.config.yaml --no-cache --grader ${JUDGE_PROVIDER:-ollama:chat:qwen3-coder:30b}",
    "prompt:feedback": "node scripts/prompt-feedback-loop.mjs",
    "test:e2e": "playwright test",
    "test:e2e:real": "RUN_REAL_LLM=1 playwright test tests/semantic-web-real-llm.spec.mjs",
    "dry": "npm run generate:rdf-graph && npm run check:app && npm run prompt:feedback && npm run eval && npm run eval:prompt && npm run test:e2e && git diff --check"
  },
  "dependencies": {
    "@hpcc-js/wasm": "^2.35.0",
    "n3": "^2.1.1",
    "ts-graphviz": "^3.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "promptfoo": "^0.121.19"
  }
}
